{
  "name": "comic-sfx",
  "version": "1.0.0",
  "description": "Vintage comic-book sound effects (BLAM!, KABOOM!, SKREEECH!) for text games. Real text plus CSS keyframes, no dependencies.",
  "type": "module",
  "main": "./comic-sfx.js",
  "exports": {
    ".": "./comic-sfx.js",
    "./comic-sfx.css": "./comic-sfx.css",
    "./package.json": "./package.json"
  },
  "files": [
    "comic-sfx.js",
    "comic-sfx.css",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "comic",
    "sound-effects",
    "onomatopoeia",
    "text-game",
    "interactive-fiction",
    "css-animation",
    "typography",
    "no-dependencies"
  ],
  "author": "Helvetiaai (https://github.com/Helvetiaai)",
  "license": "MIT",
  "homepage": "https://helvetiaai.github.io/comic-sfx/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helvetiaai/comic-sfx.git"
  },
  "bugs": {
    "url": "https://github.com/Helvetiaai/comic-sfx/issues"
  },
  "sideEffects": [
    "./comic-sfx.css",
    "./comic-sfx.js"
  ]
}
